{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "node", "vite/client"]
  },
  "files": [
    "src/manifest.ts",
    "src/background/index.ts",
    "src/content/index.ts",
    "src/bridge/index.ts",
    "src/popup/main.tsx",
    "src/options/main.tsx",
    "tests/agent.test.ts",
    "tests/editor.test.ts",
    "tests/explain.test.ts",
    "tests/fixes.test.ts",
    "tests/openrouter.test.ts",
    "tests/schemas.test.ts",
    "tests/timing.test.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
